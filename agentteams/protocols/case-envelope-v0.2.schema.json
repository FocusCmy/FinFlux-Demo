{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finflux.local/schemas/case-envelope-v0.2.schema.json",
  "title": "FinFlux CaseEnvelope V0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol", "schema_version", "case_id", "source_case_id", "run_id",
    "profile", "asset_class", "declared_purpose", "trigger", "evidence_handles",
    "route_request", "execution", "required_outputs", "created_at_utc",
    "legacy_reference", "envelope_sha256"
  ],
  "properties": {
    "protocol": {"const": "FINFLUX_CASE_ENVELOPE_V0.2"},
    "schema_version": {"const": "0.2.0"},
    "case_id": {"type": "string", "minLength": 1},
    "source_case_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "profile": {"$ref": "#/$defs/profileRef"},
    "asset_class": {"enum": ["equity", "futures", "option", "research"]},
    "declared_purpose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose_id", "statement", "target_decision", "accountable_role"],
      "properties": {
        "purpose_id": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "target_decision": {"type": "string", "minLength": 1},
        "accountable_role": {"type": "string", "minLength": 1}
      }
    },
    "trigger": {"type": "string", "minLength": 1},
    "evidence_handles": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidenceHandle"}
    },
    "route_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_route", "human_gate_required"],
      "properties": {
        "expected_route": {
          "enum": [
            "CODE_ONLY_PASS", "HUMAN_REVIEW_WITHOUT_IMPACT", "FULL_TEAM_REVIEW",
            "POST_REMEDIATION_FULL_TEAM_REVIEW", "PRESERVE_DISPUTE_AND_ESCALATE",
            "BLAST_RADIUS_REVIEW"
          ]
        },
        "human_gate_required": {"const": true}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "dispatch_idempotency_key"],
      "properties": {
        "policy_id": {"type": "string", "minLength": 1},
        "dispatch_idempotency_key": {"$ref": "#/$defs/sha256"}
      }
    },
    "required_outputs": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "created_at_utc": {"type": "string", "format": "date-time"},
    "legacy_reference": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_protocol", "source_sha256", "migration_status",
            "content_hash_resolution", "unmapped_fields"
          ],
          "properties": {
            "source_protocol": {"type": "string", "minLength": 1},
            "source_sha256": {"$ref": "#/$defs/sha256"},
            "migration_status": {"enum": ["LOSSLESS", "BOUNDED_PROJECTION"]},
            "content_hash_resolution": {"enum": ["SOURCE_DIGEST", "COMPUTED_FROM_LOCAL_EVIDENCE"]},
            "unmapped_fields": {
              "type": "array", "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    },
    "envelope_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "profileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_version", "profile_sha256"],
      "properties": {
        "profile_id": {
          "enum": [
            "equity_corporate_action", "futures_settlement",
            "option_contract_identity", "research_material_rights"
          ]
        },
        "profile_version": {"const": "0.2.0"},
        "profile_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidenceHandle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id", "evidence_type", "content_sha256", "source_locator",
        "media_type", "rights_state", "version_id"
      ],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "evidence_type": {"type": "string", "minLength": 1},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "source_locator": {"type": "string", "minLength": 1},
        "media_type": {"type": "string", "minLength": 1},
        "rights_state": {"enum": ["PUBLIC", "AUTHORIZED", "RESTRICTED", "REVIEW_REQUIRED"]},
        "version_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
