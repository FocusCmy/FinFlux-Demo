{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FinChange Agent Message",
  "type": "object",
  "required": ["case_id", "task_id", "sender_role", "message_type", "claim", "evidence_ids", "tool_run_ids", "confidence", "requested_action"],
  "properties": {
    "case_id": {"type": "string"},
    "task_id": {"type": "string"},
    "sender_role": {"enum": ["manager", "team_leader", "evidence_investigator", "semantic_impact_analyst", "independent_validator", "human_owner"]},
    "message_type": {"enum": ["TASK", "FINDING", "DISAGREEMENT", "EVIDENCE_REQUEST", "RECOMMENDATION", "HUMAN_DECISION", "SKILL_CANDIDATE"]},
    "claim": {"type": "string"},
    "evidence_ids": {"type": "array", "items": {"type": "string"}},
    "tool_run_ids": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "disagreement": {
      "type": ["object", "null"],
      "properties": {
        "with_task_id": {"type": "string"},
        "field": {"type": "string"},
        "reason": {"type": "string"}
      }
    },
    "requested_action": {"enum": ["NONE", "VERIFY", "RECOMPUTE", "REQUEST_EVIDENCE", "HUMAN_REVIEW", "PASS", "BLOCK"]},
    "created_at_utc": {"type": "string"}
  },
  "additionalProperties": false
}

