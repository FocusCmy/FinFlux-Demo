# Copy this file to .env and fill the blank values yourself before deployment.
# No real provider, model, password, or API key is stored in this repository.
#
# AgentTeams v1.2.2 provider modes used by the official installer:
#   qwen            = Alibaba Cloud Model Studio native provider
#   openai-compat   = DeepSeek, OpenCode Go, Alibaba Coding/Token Plan, etc.
#
# OpenAI-compatible examples (comments only):
#   DeepSeek:    AGENTTEAMS_OPENAI_BASE_URL=https://api.deepseek.com
#   OpenCode Go: AGENTTEAMS_OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
#   Alibaba:     AGENTTEAMS_OPENAI_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
# Base URL must not include /chat/completions, /responses, or /messages.
# Keep the distributable template provider-neutral. Put real values only in an
# external env file or in this checkout's git-ignored agentteams/.env.
AGENTTEAMS_LLM_PROVIDER=
AGENTTEAMS_DEFAULT_MODEL=
AGENTTEAMS_OPENAI_BASE_URL=
AGENTTEAMS_LLM_API_KEY=
# AgentTeams官方自定义模型输出上限；只限制单次模型输出，完整Run仍由
# execution_policy.json中的消息数、墙钟时间和观测量门禁共同约束。
AGENTTEAMS_MODEL_MAX_TOKENS=2048

# Fixed v1.2.2 local deployment contract.
AGENTTEAMS_VERSION=v1.2.2
AGENTTEAMS_NON_INTERACTIVE=1
AGENTTEAMS_MOUNT_SOCKET=1
AGENTTEAMS_DATA_DIR=finchange-agentteams-data-v122
# Optional. Leave blank to use <repository>/agentteams/runtime-workspace.
AGENTTEAMS_WORKSPACE_DIR=
AGENTTEAMS_PORT_GATEWAY=18080
AGENTTEAMS_PORT_CONSOLE=18001
AGENTTEAMS_PORT_ELEMENT_WEB=18088
AGENTTEAMS_PORT_MANAGER_CONSOLE=18888
AGENTTEAMS_ADMIN_USER=admin
AGENTTEAMS_ADMIN_PASSWORD=
AGENTTEAMS_MATRIX_DOMAIN=matrix-local.agentteams.io:18080
# v1.2.2 Windows installer still uses the compatibility selector "copaw" for
# the QwenPaw Manager image. Worker CRs use the canonical value "qwenpaw".
AGENTTEAMS_MANAGER_RUNTIME=copaw
AGENTTEAMS_DEFAULT_WORKER_RUNTIME=qwenpaw

# Immutable v1.2.2 image pins verified on 2026-08-16. These values are not
# credentials. Keeping them prevents a mutable tag from changing the demo.
AGENTTEAMS_INSTALL_EMBEDDED_IMAGE=higress-registry.cn-hangzhou.cr.aliyuncs.com/agentteams/agentteams-embedded@sha256:c7e467bfa5a2a733ea021c19f223180eef85e3e534873feceb8a7a132253125f
AGENTTEAMS_INSTALL_MANAGER_COPAW_IMAGE=higress-registry.cn-hangzhou.cr.aliyuncs.com/agentteams/agentteams-manager-copaw@sha256:ebf80c4b8296b11ac1bc295329740542fb4c9c0365273019ad70062138477518
AGENTTEAMS_INSTALL_QWENPAW_WORKER_IMAGE=higress-registry.cn-hangzhou.cr.aliyuncs.com/agentteams/agentteams-qwenpaw-worker@sha256:5a8c60926009551f7ce555f657d63c8791450196a79ab41ba8bafd2e1bd51834
AGENTTEAMS_INSTALL_WORKER_IMAGE=higress-registry.cn-hangzhou.cr.aliyuncs.com/agentteams/agentteams-worker@sha256:301f9e311654eca203246fa666d63a126244ea8793f700603d2a6d37b7ffea75
AGENTTEAMS_INSTALL_COPAW_WORKER_IMAGE=higress-registry.cn-hangzhou.cr.aliyuncs.com/agentteams/agentteams-copaw-worker@sha256:7a6780ef76b6c7b056a2c343eeabc697f70108dae153afe8ddb76a3fad9a41b4
AGENTTEAMS_INSTALL_HERMES_WORKER_IMAGE=higress-registry.cn-hangzhou.cr.aliyuncs.com/agentteams/agentteams-hermes-worker@sha256:e611f38e1aa2451c97b979ae944a787f0db69c9d65c21c72a05ab33b53288e4e

# Optional role-level model routing. Blank model values inherit
# AGENTTEAMS_DEFAULT_MODEL. Blank provider values inherit the default gateway
# route. To use multiple providers, first create the named Model API routes in
# Higress, then put those route names in *_MODEL_PROVIDER.
FINCHANGE_MANAGER_MODEL=
FINCHANGE_MANAGER_MODEL_PROVIDER=
FINCHANGE_LEADER_MODEL=
FINCHANGE_LEADER_MODEL_PROVIDER=
FINCHANGE_EVIDENCE_MODEL=
FINCHANGE_EVIDENCE_MODEL_PROVIDER=
FINCHANGE_ANALYST_MODEL=
FINCHANGE_ANALYST_MODEL_PROVIDER=
FINCHANGE_VALIDATOR_MODEL=
FINCHANGE_VALIDATOR_MODEL_PROVIDER=
FINCHANGE_RESULT_MODEL=
FINCHANGE_RESULT_MODEL_PROVIDER=

# The Human password is generated by the Human CR and is distinct from both
# the admin password and model API key. Copy it here only after creation.
FINCHANGE_MATRIX_HUMAN_USER=finchange-data-owner
FINCHANGE_MATRIX_HUMAN_PASSWORD=
# Optional FinFlux operational-context memory.  Local mode is deterministic
# and requires no model.  OpenViking is advisory only and never enters the
# financial truth or Human-signature path.
FINFLUX_CONTEXT_MEMORY_BACKEND=local
FINFLUX_OPENVIKING_URL=
FINFLUX_OPENVIKING_API_KEY=
FINFLUX_OPENVIKING_TIMEOUT_MS=500
FINFLUX_CONTEXT_MEMORY_MAX_TOKENS=256
FINFLUX_OPENVIKING_TARGET_ROOT=viking://~/memories/finflux
FINFLUX_OPENVIKING_REMOTE_WRITE=0
