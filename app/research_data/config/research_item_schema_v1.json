{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finflux.local/schemas/research-item/1.0.0",
  "title": "FinFlux ResearchItem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "research_item_id",
    "provider_id",
    "provider_tier",
    "content_type",
    "source_document_id",
    "source_url",
    "title",
    "publisher",
    "language",
    "published_at",
    "captured_at",
    "document_version",
    "raw_response_sha256",
    "metadata_sha256",
    "rights_state",
    "storage_policy",
    "citation_text",
    "parser_version",
    "normalizer_version",
    "adapter_version",
    "retrieval_method",
    "quality_status",
    "point_in_time_safe"
  ],
  "properties": {
    "research_item_id": {"type": "string", "minLength": 8},
    "provider_id": {"enum": ["finrpt", "eastmoney_report", "worldbank", "imf", "bis", "ecb"]},
    "provider_tier": {"enum": ["OFFICIAL_PRIMARY", "MARKET_RESEARCH", "BENCHMARK_REFERENCE"]},
    "content_type": {"enum": ["OFFICIAL_STATISTIC", "RESEARCH_DOCUMENT", "NEWS_RELEASE", "RESEARCH_CLAIM"]},
    "source_document_id": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "format": "uri"},
    "title": {"type": "string", "minLength": 1},
    "publisher": {"type": "string", "minLength": 1},
    "authors": {"type": "array", "items": {"type": "string"}, "default": []},
    "language": {"type": "string", "minLength": 2},
    "published_at": {"type": "string", "format": "date-time"},
    "captured_at": {"type": "string", "format": "date-time"},
    "effective_at": {"type": ["string", "null"], "format": "date-time"},
    "as_of": {"type": ["string", "null"], "format": "date-time"},
    "observation_period": {"type": ["string", "null"]},
    "frequency": {"type": ["string", "null"]},
    "unit": {"type": ["string", "null"]},
    "adjustment": {"type": ["string", "null"]},
    "document_version": {"type": "string", "minLength": 1},
    "content_sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"},
    "raw_response_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "raw_response_path": {"type": "string", "minLength": 1},
    "metadata_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "rights_state": {"enum": ["OPEN_REUSE", "ATTRIBUTION_REQUIRED", "INTERNAL_AUTHORIZED", "LINK_ONLY", "REVIEW_REQUIRED", "PROHIBITED"]},
    "storage_policy": {"enum": ["FULL_CONTENT", "AUTHORIZED_CONTENT", "METADATA_ONLY", "LINK_ONLY", "QUARANTINE"]},
    "citation_text": {"type": "string", "minLength": 1},
    "parser_version": {"type": "string", "minLength": 1},
    "normalizer_version": {"type": "string", "minLength": 1},
    "adapter_version": {"type": "string", "minLength": 1},
    "retrieval_method": {"enum": ["REST_GET", "REST_POST", "SDMX", "RSS", "PINNED_DATASET"]},
    "quality_status": {"enum": ["DISCOVERED", "VERIFIED_METADATA", "VERIFIED_CONTENT", "CONFLICTED", "REJECTED"]},
    "point_in_time_safe": {"type": "boolean"},
    "entities": {"type": "array", "items": {"type": "string"}, "default": []},
    "topics": {"type": "array", "items": {"type": "string"}, "default": []},
    "attributes": {"type": "object", "additionalProperties": true},
    "locator": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "page": {"type": ["integer", "null"], "minimum": 1},
        "paragraph": {"type": ["integer", "null"], "minimum": 1},
        "table": {"type": ["string", "null"]},
        "field_path": {"type": ["string", "null"]}
      }
    },
    "supersedes": {"type": ["string", "null"]},
    "run_id": {"type": ["string", "null"]},
    "tool_call_id": {"type": ["string", "null"]}
  }
}
