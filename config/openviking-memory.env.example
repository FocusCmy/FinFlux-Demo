# Merge these keys into the external Runtime env file used to start FinFlux.
# Never commit the populated file.
FINFLUX_CONTEXT_MEMORY_BACKEND=openviking
FINFLUX_OPENVIKING_URL=http://127.0.0.1:1933
# Use an OpenViking USER or ADMIN key for normal tenant-scoped data APIs.
# Do not place server.root_api_key here.
FINFLUX_OPENVIKING_API_KEY=
FINFLUX_OPENVIKING_TIMEOUT_MS=500
FINFLUX_CONTEXT_MEMORY_MAX_TOKENS=256
FINFLUX_OPENVIKING_TARGET_ROOT=viking://~/memories/finflux
# Keep writes disabled until read-path validation succeeds.
FINFLUX_OPENVIKING_REMOTE_WRITE=0
